# OpenSmartTimer ESP32-C3 release framework profile.
# Preserve dual-stack networking and an HTTPS client suitable for future
# signed GitHub release downloads. Bluetooth is a single-connection
# peripheral only, sized so it can run beside the relay's TLS connection.

# Keep IPv6.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_DHCP6=y

# No serial/cellular PPP or IPv4 routing/NAT service.
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_IPV4_NAPT=n

# The product only accepts SSID + personal passphrase credentials.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_FTM_ENABLE=n
CONFIG_ESP_WIFI_FTM_INITIATOR_SUPPORT=n
CONFIG_ESP_WIFI_FTM_RESPONDER_SUPPORT=n

# Retain WPA2/WPA3 station and SoftAP behavior, but remove roaming/location
# extensions that OpenSmartTimer does not expose.
CONFIG_ESP_WIFI_11KV_SUPPORT=n
CONFIG_ESP_WIFI_RRM_SUPPORT=n
CONFIG_ESP_WIFI_WNM_SUPPORT=n
CONFIG_ESP_WIFI_MBO_SUPPORT=n
CONFIG_ESP_WIFI_11R_SUPPORT=n

# HTTPS client only. Keep the certificate bundle, RSA/ECDSA, SHA-256/SHA-512,
# P-256/P-384 and X25519 so a later GitHub OTA client is not designed into a
# cryptographic dead end.
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_TLS_SERVER=n
CONFIG_MBEDTLS_TLS_CLIENT=y
# A future CA-validated downloader must set wall-clock time (for example SNTP)
# before HTTPS. The existing relay uses its separate pinned-key verifier.
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=n
CONFIG_MBEDTLS_ECJPAKE_C=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_SSL_PROTO_DTLS=n
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_CAMELLIA_C=n
CONFIG_MBEDTLS_ARIA_C=n
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=n
CONFIG_MBEDTLS_PEM_WRITE_C=y
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_FS_IO=n
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y

# The application accepts one inbound phone/app controller and never scans or
# connects out. With the stock sizing (two connections, central/observer/client
# roles, default buffer pools) Bluetooth held about 64 KB of heap, which left
# the relay's TLS reconnect without room (2026-10-11 bench: 1.6 KB minimum free
# with the radio on, three viewers and a share link). The roles and pools below
# are sized for the one peripheral connection the application uses. A later
# release that implements timer-to-timer Bluetooth can restore the other roles;
# the framework is linked into each application image.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CCCDS=16
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_2M_PHY=n
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_CODED_PHY=n
CONFIG_BT_NIMBLE_EXT_SCAN=n
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC=n
CONFIG_BT_NIMBLE_WHITELIST_SIZE=4
CONFIG_BT_NIMBLE_VS_SUPPORT=n
# Buffer pools for one connection at ATT MTU 128 (stock: 12/24/24/30).
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
# Controller: one advertiser, one connection and one spare instance (stock: 6);
# no scanner or direct test mode, and the smallest duplicate-scan caches.
# BT_CTRL_BLE_MASTER is the controller's whole connection feature, not only the
# central role: with it off the controller rejects connectable advertising
# (HCI 0x12), so it stays on.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_CTRL_BLE_MASTER=y
CONFIG_BT_CTRL_BLE_SCAN=n
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=10
CONFIG_BT_CTRL_MESH_DUPL_SCAN_CACHE_SIZE=10
CONFIG_BT_CTRL_DTM_ENABLE=n

# None of the bundled example profiles are used by our custom service.
CONFIG_BT_NIMBLE_PROX_SERVICE=n
CONFIG_BT_NIMBLE_ANS_SERVICE=n
CONFIG_BT_NIMBLE_CTS_SERVICE=n
CONFIG_BT_NIMBLE_HTP_SERVICE=n
CONFIG_BT_NIMBLE_IPSS_SERVICE=n
CONFIG_BT_NIMBLE_TPS_SERVICE=n
CONFIG_BT_NIMBLE_IAS_SERVICE=n
CONFIG_BT_NIMBLE_LLS_SERVICE=n
CONFIG_BT_NIMBLE_SPS_SERVICE=n
CONFIG_BT_NIMBLE_HR_SERVICE=n
CONFIG_BT_NIMBLE_BAS_SERVICE=n
CONFIG_BT_NIMBLE_DIS_SERVICE=n

# Serial output is inaccessible on the device and the web event/diagnostic API
# remains available at the application layer.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_MAXIMUM_LEVEL=0
CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL_NONE=y

# Second-pass release size experiment. These facilities are not used by the
# application-level diagnostics, event history, reset-reason reporting, REST,
# SSE, BLE control, or HTTPS client.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=n
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=n
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
CONFIG_ESP_COREDUMP_ENABLE=n
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_ESP_GDBSTUB_ENABLED=n
CONFIG_ESP_GDBSTUB_SUPPORT_TASKS=n
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n
CONFIG_ESP_WIFI_CSI_ENABLED=n
CONFIG_ESP_INSIGHTS_ENABLED=n
CONFIG_DIAG_ENABLE_METRICS=n
CONFIG_DIAG_ENABLE_HEAP_METRICS=n
CONFIG_DIAG_ENABLE_WIFI_METRICS=n
CONFIG_DIAG_ENABLE_VARIABLES=n
CONFIG_DIAG_ENABLE_NETWORK_VARIABLES=n

# Size audit (2026-09-28): assertions stay enabled but abort without their
# expression, file and function strings (serial output is unreachable, and a
# failed assertion still panics, reboots and drives the lock output low).
# The esp_err_t name table is only used for console text.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n

# Make package output independent of wall-clock build time.
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_BOOTLOADER_COMPILE_TIME_DATE=n
CONFIG_APP_COMPILE_TIME_DATE=n
