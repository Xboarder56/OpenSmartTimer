# Copy to `.env` and fill in real values. NEVER commit .env.
# Both secrets below MUST be generated per-deployment; the values in
# this file are placeholders.

# Public relay API origin; trusted partner assets are hosted separately.
OSTRELAY_PUBLIC_URL=https://ost.example.com
OSTRELAY_HOSTNAME=ost.example.com
# Only with docker-compose.traefik.yml (OPERATOR.md, "Behind Traefik"): the
# Docker network Traefik watches, Traefik's fixed address on it, and its HTTPS
# entrypoint name.
# OSTRELAY_TRAEFIK_NETWORK=traefik-public
# OSTRELAY_TRAEFIK_IP=172.20.0.2
# OSTRELAY_TRAEFIK_ENTRYPOINT=websecure
# Suggested trusted HTTPS page origin, distinct from the relay. Owners review
# and physically approve it on the timer; use independent hosting credentials.
OSTRELAY_PARTNER_ORIGIN=https://partner.example.com

# The TLS key timers will see. Leave empty to follow the certificate served at
# OSTRELAY_PUBLIC_URL, which must then come from a public certificate
# authority; renewals need no action. Set it for a private or self-signed
# certificate (OPERATOR.md section 2). Several pins may be separated by commas.
OSTRELAY_SPKI_PIN=
# Optional host:port to read that certificate from when this container cannot
# reach its own public address, for example the reverse proxy's service name.
# OSTRELAY_TLS_PROBE_ADDRESS=caddy:443

# 64+ character opaque bearer token that gates every /admin/* route.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
OSTRELAY_ADMIN_TOKEN=REPLACE_ME_64_HEX
# Set false to remove every admin page/API route, including private previews.
# Command-line enrollment helpers remain available; restart to apply.
OSTRELAY_ADMIN_ENABLED=true

# 32-byte hex secret for owner/OIDC login state. Partner channels use their own
# endpoint-derived ECDH keys; this secret neither stores nor decrypts link tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
OSTRELAY_COOKIE_SECRET=REPLACE_ME_64_HEX

# Where the SQLite file lives inside the container. Persisted via the
# ostrelay-data volume in docker-compose.yml. Backup + rotate story in
# OPERATOR.md § backup.
OSTRELAY_DB_PATH=/data/ostrelay.sqlite

# Who may enroll timers (OPERATOR.md section 3):
#   owner_codes       your own relay, or friends you invite (default). The
#                     first owner's setup code is printed in the log on first
#                     start: docker compose logs relay
#   open              anyone can get a setup code at https://<host>/setup
#   owner_codes,open  both
OSTRELAY_ENROLLMENT=owner_codes
# With open permitted here, admin can pause/resume new anonymous enrollment.
# Existing registrations and share links are unaffected by that toggle.
# Public introduction at /. Admin can hide it and keep that preference in
# SQLite. Set false to force it off even if enabled in admin. This does NOT
# disable /setup enrollment, trusted-origin share links, or the private admin preview.
OSTRELAY_LANDING_PAGE_ENABLED=true
# OSTRELAY_MAX_ENROLLED_TIMERS=100
# OSTRELAY_MAX_TIMERS_PER_OWNER=10
# OSTRELAY_RATE_OPEN_ENROLLMENTS_PER_IP_1H=5

# Optional owner sign-in (OIDC, e.g. PocketID, Authentik, Keycloak). With an
# issuer set, owners sign in at https://<host>/owner to create their own setup
# code and manage their timers. Leave empty to hand out codes yourself from the
# admin page (admin token). Register this redirect URI at your provider:
#   <OSTRELAY_PUBLIC_URL>/owner/callback
# OSTRELAY_OIDC_ISSUER=https://id.example.com
# OSTRELAY_OIDC_CLIENT_ID=
# OSTRELAY_OIDC_CLIENT_SECRET=
# OSTRELAY_OIDC_SCOPES=openid profile email groups
# OSTRELAY_OIDC_ALLOWED_GROUPS=timer-owners     # empty = any account at the provider
# OSTRELAY_OIDC_GROUPS_CLAIM=groups
# OSTRELAY_OIDC_SIGNING_ALG=RS256
# OSTRELAY_OIDC_PROVIDER_NAME=PocketID           # button: "Sign in with PocketID"

# Admin page (http://<address>:8080/admin/) is on localhost only by default.
# To manage owners from another computer on your home network, set this to the
# relay host's LAN address (not 0.0.0.0 on a host with a public address).
# OSTRELAY_ADMIN_BIND=192.168.1.20

# Optional: tune rate limits per spec § 10.
# OSTRELAY_RATE_PER_SESSION_5MIN=300
# OSTRELAY_RATE_PER_TIMER_5MIN=3000
# OSTRELAY_RATE_SESSION_CREATES_PER_IP_1MIN=10
# OSTRELAY_MAX_OWNER_SESSIONS=1000
# OSTRELAY_MAX_OWNER_SESSIONS_PER_OWNER=8
# OSTRELAY_MAX_OWNERS=1000
