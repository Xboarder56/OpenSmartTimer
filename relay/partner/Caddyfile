{
    auto_https off
    admin off
}
https://{$OSTPARTNER_HOSTNAME}:8444 {
    tls /certs/fullchain.pem /certs/key.pem
    root * /srv/partner
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Cache-Control "no-store"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src {$OSTPARTNER_RELAY_ORIGIN}; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
    }
    @shell path /s /s/ /s/*
    handle_path /s/assets/* {
        file_server
    }
    handle @shell {
        rewrite * /index.html
        file_server
    }
    handle {
        respond "Not found" 404
    }
}
