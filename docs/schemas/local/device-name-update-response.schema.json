{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xboarder56.github.io/OpenSmartTimer/schemas/local/device-name-update-response.schema.json",
  "title": "PUT /api/v1/device/name (response body)",
  "type": "object",
  "required": ["updated", "restarting", "name", "hostname"],
  "additionalProperties": false,
  "properties": {
    "updated":    { "type": "boolean" },
    "restarting": { "type": "boolean" },
    "name":       { "type": "string", "maxLength": 32 },
    "hostname":   { "type": "string" },
    "ap_ssid":    { "type": "string", "maxLength": 32 },
    "ap_security": { "$ref": "common.schema.json#/$defs/ApSecurity" }
  }
}
