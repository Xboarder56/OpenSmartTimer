{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xboarder56.github.io/OpenSmartTimer/schemas/local/ota-prepare-request.schema.json",
  "title": "POST /api/v1/ota/prepare (request body)",
  "description": "Reserves ~10 seconds of quiet before an OTA upload so other bundled UI clients receive 503 ota_in_progress and back off. Does not write flash or consume the physical arm. Sent as form or JSON.",
  "type": "object",
  "required": [
    "image_size",
    "image_crc32"
  ],
  "additionalProperties": false,
  "properties": {
    "image_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Application image size in bytes."
    },
    "image_crc32": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}$",
      "description": "8-digit lowercase or uppercase hex CRC32."
    },
    "release_version": {
      "type": "string",
      "maxLength": 47,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "dependentRequired": {
    "release_version": [
      "release_version",
      "image_sha256",
      "release_signature"
    ],
    "image_sha256": [
      "release_version",
      "image_sha256",
      "release_signature"
    ],
    "release_signature": [
      "release_version",
      "image_sha256",
      "release_signature"
    ]
  }
}
