{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xboarder56.github.io/OpenSmartTimer/schemas/local/bluetooth-status.schema.json",
  "title": "GET /api/v1/bluetooth (V2 only)",
  "description": "V2 BLE radio preference, paired-controller state, pairing ceremony, link security, application authentication, and command counters. Never exposes the stored 128-bit application key. V1 does not implement this endpoint.",
  "type": "object",
  "additionalProperties": true,
  "required": ["supported", "protocol", "mode"],
  "properties": {
    "approved_app_limit": { "const": 3 },
    "approved_app_count": { "type": "integer", "minimum": 0, "maximum": 3 },
    "active_app_id": { "type": "integer", "minimum": 0 },
    "approved_apps": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["app_id", "label", "connected", "last_seen_at_ms"],
        "properties": {
          "app_id": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1, "maxLength": 24, "description": "Maximum 24 UTF-8 bytes, not 24 arbitrary Unicode characters." },
          "connected": { "type": "boolean" },
          "last_seen_at_ms": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "supported":                                     { "const": true },
    "protocol":                                      { "const": "ost-ble/1" },
    "mode":                                          { "const": "bonded_authenticated_control" },
    "default_enabled":                               { "type": "boolean" },
    "configured_enabled":                            { "type": "boolean", "description": "Persistent radio preference; may be true while enabled is still false during the 15s Wi-Fi-recovery wait after boot." },
    "persistent_enable":                             { "type": "boolean" },
    "volatile_enable":                               { "type": "boolean" },
    "enable_path":                                   { "type": "string" },
    "disable_path":                                  { "type": "string" },
    "advertised_name":                               { "type": "string", "pattern": "^(OST-[0-9a-f]{6})?$", "description": "Empty before Bluetooth initializes; otherwise OST- followed by the short device ID." },
    "initialized":                                   { "type": "boolean" },
    "enabled":                                       { "type": "boolean" },
    "synchronized":                                  { "type": "boolean" },
    "advertising":                                   { "type": "boolean" },
    "connected":                                     { "type": "boolean" },
    "subscribed":                                    { "type": "boolean" },
    "connections":                                   { "type": "integer", "minimum": 0 },
    "connection_limit":                              { "type": "integer", "minimum": 0 },
    "accepted_count":                                { "type": "integer", "minimum": 0 },
    "closed_count":                                  { "type": "integer", "minimum": 0 },
    "notification_count":                            { "type": "integer", "minimum": 0 },
    "last_error":                                    { "type": "integer" },
    "last_error_name":                               { "type": "string" },
    "last_disconnect_reason":                        { "type": "integer" },
    "last_disconnect_reason_name":                   { "type": "string" },
    "connection_rssi_dbm":                           { "type": ["integer", "null"] },
    "connection_mtu":                                { "type": "integer", "minimum": 0 },
    "connection_encrypted":                          { "type": "boolean" },
    "connection_bonded":                             { "type": "boolean" },
    "paired":                                        { "type": "boolean" },
    "pairing_state":                                 { "type": "string", "enum": ["idle", "waiting_for_connection", "securing_connection", "waiting_for_button", "secret_ready", "waiting_for_commit", "committing", "complete", "failed"] },
    "pairing_active":                                { "type": "boolean" },
    "pairing_remaining_ms":                          { "type": "integer", "minimum": 0 },
    "pairing_failure":                               { "type": "string" },
    "physical_pairing_supported":                    { "type": "boolean" },
    "control_supported":                             { "type": "boolean" },
    "control_default_enabled":                       { "type": "boolean" },
    "control_volatile":                              { "type": "boolean" },
    "control_enabled":                               { "type": "boolean" },
    "control_authenticated":                         { "type": "boolean" },
    "control_authentication":                        { "const": "bonded-hmac-sha256-112" },
    "command_integrity":                             { "const": "hmac-sha256-64-counter" },
    "control_authentication_failure_count":          { "type": "integer", "minimum": 0 },
    "control_authentication_failure_limit":          { "type": "integer", "minimum": 0 },
    "control_authentication_backoff_remaining_ms":   { "type": "integer", "minimum": 0 },
    "control_command_count":                         { "type": "integer", "minimum": 0 },
    "control_last_result":                           { "type": "string" },
    "pairing_start_path":                            { "type": "string" },
    "pairing_cancel_path":                           { "type": "string" },
    "pairing_revoke_path":                           { "type": "string" },
    "control_boot_id":                               { "type": "integer", "minimum": 0 },
    "required_control_mtu":                          { "type": "integer", "minimum": 0, "description": "Minimum ATT MTU needed to fit a 32-byte control command; clients should check this before sending." },
    "connection_mtu_sufficient":                     { "type": "boolean" },
    "bond_cleanup_pending":                          { "type": "boolean", "description": "true when key revocation succeeded but bond erasure is being retried." },
    "bond_cleanup_last_error":                       { "type": "integer" },
    "peer_discovery_supported":                      { "const": false },
    "peer_control_supported":                        { "const": false }
  }
}
